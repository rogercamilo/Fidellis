# ======================================================================
# Fidellis — variáveis de ambiente (copie para .env e ajuste)
# ======================================================================

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fidellis
POSTGRES_USER=fidellis
POSTGRES_PASSWORD=fidellis_dev
# Connection string usada pelo core .NET (Npgsql)
DATABASE_URL=Host=localhost;Port=5432;Database=fidellis;Username=fidellis;Password=fidellis_dev

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Core (.NET) ----------
CORE_URL=http://localhost:5080
ASPNETCORE_ENVIRONMENT=Development

# ---------- BFF (NestJS) ----------
BFF_PORT=4000
# Segredo compartilhado para assinar/validar JWT entre BFF e Core.
JWT_SECRET=change-me-in-prod-please-use-a-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---------- Web (Next.js) ----------
NEXT_PUBLIC_BFF_URL=http://localhost:4000

# ---------- Régua de relacionamento / e-mail (passo 4) ----------
# API key do Resend (vazia = e-mails caem em log, sem envio). Domínio precisa estar verificado.
RESEND_API_KEY=
MAIL_FROM=Fidellis <onboarding@resend.dev>
# Dias sem doação para considerar um doador inativo (reativação).
REACTIVATION_DAYS=90
# WhatsApp (placeholder; envio real fica para quando houver conta BSP).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---------- Billing / recorrência (passo 2) ----------
# Liga o worker de cobrança recorrente + dunning (use 'false' em CI/testes).
BILLING_ENABLED=true
BILLING_INTERVAL_SECONDS=300
# Agenda de dunning (dias após a falha); o tamanho é o nº de tentativas.
BILLING_DUNNING_DAYS=1,3,5
# Validade do PIX de cada ciclo (segundos).
BILLING_CYCLE_EXPIRY_SECONDS=86400

# ---------- PSP: Pagar.me / Stone ----------
# Secret key de teste (sk_test_...) usada como usuário no Basic auth da API Core v5.
PAGARME_API_KEY=
PAGARME_BASE_URL=https://api.pagar.me/core/v5
# Basic auth configurado na URL de webhook do Pagar.me (o receptor do core valida essas credenciais).
PAGARME_WEBHOOK_USER=fidellis
PAGARME_WEBHOOK_PASSWORD=change-me-webhook-secret

# ---------- Cloudflare R2 / S3 (storage; fora do MVP) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fidellis-assets
